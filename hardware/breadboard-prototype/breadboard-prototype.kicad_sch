	(text "NFC-dismiss alarm clock | Breadboard prototype"
		(at 15 15 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0d555588-9d26-4cfe-b195-58611a9c00af")
	)
	(text "Revision A - Module terminal names follow board silkscreen; onboard circuits and unused headers omitted."
		(at 15 23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f842a298-eef0-4e67-9c27-0278798aef47")
	)
	(text "USB / BATTERY / POWER"
		(at 15 35 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "732bc9ac-58b1-481e-b5c7-fea109c7b6d3")
	)
	(text "WI-FI CONTROLLER"
		(at 150 40 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2da11eca-cd67-40d9-949f-3fa8196708d8")
	)
	(text "DISPLAY"
		(at 285 30 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0942a113-e37f-4f5f-98a6-b2e8720d98b6")
	)
	(text "U2: built-in USB-C input, 5 V supply.\nSet charge jumper to 500 mA for BT1.\nVCC = LOAD OUT, approximately 3-4.4 V."
		(at 15 76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e7187d67-77f4-4202-b48b-a5ec583e58b6")
	)
	(text "BT1: protected 1S LiPo, 4.2 V full. Check JST polarity.\nU3: +5V net is nominally 5.2 V. EN tied to IN.\nDisconnect U3 OUT from U1 5V before programming by USB."
		(at 15 125 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "eabcae30-9eb2-4870-9103-2869c5ec7be8")
	)
	(text "3.3 V GPIO. Configure octal flash and PSRAM.\nWeb configuration over Wi-Fi; MCU stays awake."
		(at 150 102 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c6c4c200-f9f1-472a-8b78-5c7458ede0ea")
	)
	(text "Battery divider: read BAT, not LOAD OUT.\nADC maximum 2.1 V; configure attenuation\nand calibrate. C2 filters the ADC input."
		(at 222 120 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "239624ce-5744-49b5-aae3-13ca861dae3d")
	)
	(text "I2S AUDIO"
		(at 15 144 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "42593de0-2218-40e1-a9e3-ac2a3c2c480c")
	)
	(text "NFC READER"
		(at 150 154 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "61d0cd92-38b8-4af8-9f14-e5277a95aef2")
	)
	(text "SH1107, I2C 0x3C. Pulse RST at startup.\nUse Adafruit SH110X driver. OLED buttons unused."
		(at 285 76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "99bd7ea2-4531-4735-b9e5-75e0a3b3029c")
	)
	(text "REAL-TIME CLOCK"
		(at 285 90 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7f648eb7-12a1-4a0d-a735-8f5aa1120c5a")
	)
	(text "PCF8523, I2C 0x68. Insert CR1220 in onboard holder.\nSQW unused: alarms handled by running firmware."
		(at 285 126 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2fedd9b7-621c-41d9-9065-786a2b477c64")
	)
	(text "AMBIENT LIGHT"
		(at 285 137 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "d64b87aa-0e67-4531-99d3-93ff097de0af")
	)
	(text "BH1750, default I2C 0x23. Power from 3.3 V."
		(at 285 170 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "052d2a73-10c1-49ed-8ece-484ad0cf183e")
	)
	(text "ROTARY ENCODER + PUSH"
		(at 285 185 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b0f8177c-5174-4d21-b615-91f02ca3dd99")
	)
	(text "Seesaw, default I2C 0x36. Poll rotation and push over I2C.\nINT unused. Module handles encoder decoding."
		(at 285 222 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "16961d86-698f-4f84-b0af-0e8ea0c1e3f9")
	)
	(text "BUTTONS"
		(at 285 233 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "85f508ba-3b7d-4808-8784-43bae8bb72d0")
	)
	(text "ASSEMBLY NOTES"
		(at 15 221 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c7b88ff8-2e79-42be-8c04-2db87cabfca0")
	)
	(text "All grounds common. I2C uses 3.3 V; begin at 100 kHz with short wires.\nBreakout boards include pull-ups and decoupling; extra bus pull-ups are not fitted.\nTest combined 3.3 V load during Wi-Fi + NFC activity before relying on battery mode.\nFunctional breadboard wiring only: no PCB layout or fabrication footprints.\nU9 is the proposed PN7160 module; confirm this model before buying/wiring."
		(at 15 241 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1977f978-0f13-4e18-9d9c-a9ec1e3f3cd6")
	)
	(text "External USB / battery / ground source declarations:"
		(at 15 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f2eeefbf-2640-4eeb-8ecd-7b347241e790")
	)
	(text "GAIN to VIN = 6 dB. SD open uses onboard mono mix.\nPlace C1 close to amplifier VIN/GND; observe polarity.\nKeep speaker pair short; neither speaker wire goes to GND."
		(at 15 207 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b4337a4a-8925-4940-9c1c-0610fc671dfb")
	)
	(text "U9: MIKROE-6453 NFC 7 Click I2C / PN7160.\nSet VCC SEL to 3.3 V and interface straps to I2C.\nVEN is mikroBUS PWM; IRQ is INT. RST is ClickID, unused.\nKeep antenna clear of metal, speaker, and power wiring."
		(at 150 207 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "03607365-24c2-460d-807d-9da7a478c9dd")
	)
	(text "Enable internal pull-ups; pressed = LOW."
		(at 285 239 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1c29a1e4-84db-42b3-ba1f-95810d26f7e8")
	)
